<Project Sdk="Microsoft.NET.Sdk">
  <!-- FPKG test oracle: drives SvenGDK/LibProsperoPKG to build and extract
       debug packages. dotnet build -p:LibProsperoPkgDir=/path/to/LibProsperoPKG -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LibProsperoPkgDir Condition="'$(LibProsperoPkgDir)' == ''">$(MSBuildThisFileDirectory)../../.refs/LibProsperoPKG-sven</LibProsperoPkgDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(LibProsperoPkgDir)/src/LibProsperoPkg/LibProsperoPkg.csproj" />
  </ItemGroup>
</Project>
