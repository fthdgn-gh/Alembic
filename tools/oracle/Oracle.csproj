<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test oracle: runs PS5PKGTool's own code so Alembic's output can be
       compared byte for byte. Point PS5PKGToolDir at a PS5PKGTool checkout:
       dotnet build -p:PS5PKGToolDir=/path/to/PS5PKGTool -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PS5PKGToolDir Condition="'$(PS5PKGToolDir)' == ''">$(MSBuildThisFileDirectory)../../.refs/PS5PKGTool</PS5PKGToolDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(PS5PKGToolDir)/PS5PKGTool.Ffpfsc/PS5PKGTool.Ffpfsc.csproj" />
  </ItemGroup>
  <!-- patch_ufs2.py's reproducible copy of PS5PKGTool's UFS2 writer (UFS2ToolPatched). -->
  <ItemGroup Condition="'$(Ufs2PatchedDir)' != ''">
    <Compile Include="$(Ufs2PatchedDir)/*.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Ufs2PatchedDir)' != ''">
    <DefineConstants>$(DefineConstants);UFS2_PATCHED</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CA1416</NoWarn>
  </PropertyGroup>
</Project>
