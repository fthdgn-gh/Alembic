# Writes OUTPUT, a C++ file with the bytes of every *.toml in INPUT_DIR as
# alembic::lz4pack::detail::kEmbeddedProfiles (see lz4pack_profile.cpp).
# Run with: cmake -DINPUT_DIR=... -DOUTPUT=... -P embed_files.cmake
file(GLOB files RELATIVE "${INPUT_DIR}" "${INPUT_DIR}/*.toml")
list(SORT files)
set(body "// Generated by cmake/embed_files.cmake. Do not edit.\n#include <cstddef>\n\nnamespace alembic::lz4pack::detail {\n\nstruct EmbeddedFile {\n    const char* name;\n    const unsigned char* data;\n    std::size_t size;\n};\n\n")
set(entries "")
set(index 0)
foreach(name IN LISTS files)
    file(READ "${INPUT_DIR}/${name}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "static const unsigned char kFile${index}[] = {${bytes}0x00};\n")
    string(APPEND entries "    {\"${name}\", kFile${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "\nextern const EmbeddedFile kEmbeddedProfiles[] = {\n${entries}    {nullptr, nullptr, 0},\n};\nextern const std::size_t kEmbeddedProfileCount = ${index};\n\n} // namespace alembic::lz4pack::detail\n")
file(WRITE "${OUTPUT}.tmp" "${body}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
