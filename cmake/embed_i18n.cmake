# Writes OUTPUT, a C++ file with every i18n.<name>.json in DIR (one per
# language, "messages" for the engine's message patterns), in NAMESPACE:
#   extern const std::size_t kI18nCount;
#   extern const char* const kI18nNames[];  // "de", "es", ..., "messages", ...
#   extern const char* const kI18nData[];   // each file's bytes, NUL-terminated
#   extern const std::size_t kI18nSizes[];
# Run with: cmake -DDIR=... -DOUTPUT=... -DNAMESPACE=... -P embed_i18n.cmake
file(GLOB files "${DIR}/i18n.*.json")
list(SORT files)
set(body "")
set(names "")
set(datas "")
set(sizes "")
set(count 0)
foreach(path IN LISTS files)
    get_filename_component(file_name "${path}" NAME)
    string(REGEX REPLACE "^i18n\\.(.+)\\.json$" "\\1" name "${file_name}")
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "static const unsigned char k${count}[] = {${bytes}0x00};\n")
    string(APPEND names "\"${name}\", ")
    string(APPEND datas "reinterpret_cast<const char*>(k${count}), ")
    string(APPEND sizes "${size}, ")
    math(EXPR count "${count} + 1")
endforeach()
if(count EQUAL 0)
    message(FATAL_ERROR "no i18n.*.json in ${DIR}")
endif()
file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/embed_i18n.cmake from ${DIR}/i18n.*.json. Do not edit.\n#include <cstddef>\n\nnamespace ${NAMESPACE} {\n\n${body}\nextern const std::size_t kI18nCount = ${count};\nextern const char* const kI18nNames[] = {${names}};\nextern const char* const kI18nData[] = {${datas}};\nextern const std::size_t kI18nSizes[] = {${sizes}};\n\n} // namespace ${NAMESPACE}\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
